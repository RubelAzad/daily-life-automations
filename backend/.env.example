APP_ENV=local
PORT=8080
WEB_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dailytask
DB_USER=root
# Quote the value if it contains # or spaces
DB_PASSWORD='change-me'

# Uploaded files (local development storage; git-ignored)
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# AI assistant (Claude API). Leave the key empty to keep AI features off.
# Get a key at https://console.anthropic.com/ ; never commit it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60
